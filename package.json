{
  "name": "mcp-light-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "electron": "electron .",
    "dev": "npx prisma db push --accept-data-loss && npm run build && concurrently \"npm start\" \"electron .\"",
    "generate-env": "node scripts/generate-env.js",
    "cap:sync": "npm run generate-env && npx cap sync",
    "cap:open": "npx cap open android"
  },
  "main": "main.cjs",
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@prisma/client": "^5.10.2",
    "cors": "^2.8.5",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "imapflow": "^1.7.1",
    "jsdom": "^30.0.1",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "sanitize-html": "^2.17.7",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-is-dev": "^3.0.1",
    "prisma": "^5.10.2",
    "typescript": "^5.3.3"
  }
}
