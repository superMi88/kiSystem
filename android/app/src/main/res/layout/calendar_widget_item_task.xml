<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#242437"
    android:padding="8dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:gravity="top">

    <!-- Checkbox button area -->
    <TextView
        android:id="@+id/task_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☐"
        android:textColor="#a6e3a1"
        android:textSize="18sp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Title and Notes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/task_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#cdd6f4"
                android:textSize="13sp"
                android:text="[Aufgabe] Hausaufgaben machen" />

            <TextView
                android:id="@+id/task_repeat_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄"
                android:textSize="10sp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Due Date / List Title -->
        <TextView
            android:id="@+id/task_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#a6e3a1"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:text="Fällig: Heute"
            android:visibility="gone" />

        <!-- Notes -->
        <TextView
            android:id="@+id/task_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#a6adc8"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:text="Task notes..."
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
